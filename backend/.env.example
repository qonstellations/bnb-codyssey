# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bnb-codyssey

# JWT
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

# Upstash Redis (rate limiting). On Vercel the integration's KV_REST_API_URL/TOKEN work too.
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Vercel Blob (stimuli upload)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Participant-link base. Optional: defaults to the Vercel production domain, else localhost:5173.
FRONTEND_URL=http://localhost:5173

# CORS — only needed when the frontend runs on another host (comma-separated). Unset allows any origin.
CORS_ORIGIN=http://localhost:5173

# Groq (AI experiment generation)
GROQ_API_KEY=gsk_...

# Demo caps (unset MAX_USERS = unlimited signups)
MAX_USERS=100
MAX_SESSIONS_PER_EXPERIMENT=50
MAX_STIMULI_PER_USER=15

# Local only: RATE_LIMITS=off skips Upstash buckets (npm test signs up more users than /register allows). Ignored on Vercel.
# RATE_LIMITS=off
