# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/bnb-codyssey

# JWT
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Vercel Blob (stimuli upload)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Frontend URL (for participantUrl in publish response)
FRONTEND_URL=http://localhost:5173

# CORS — comma-separated origins. In production falls back to FRONTEND_URL; unset in dev allows any origin.
CORS_ORIGIN=http://localhost:5173

# Groq (AI experiment generation)
GROQ_API_KEY=gsk_...

# Demo caps (unset MAX_USERS = unlimited signups)
MAX_USERS=100
MAX_SESSIONS_PER_EXPERIMENT=200
MAX_STIMULI_PER_USER=30

# Local only: RATE_LIMITS=off skips Upstash buckets (npm test signs up more users than /register allows). Ignored on Vercel.
# RATE_LIMITS=off
