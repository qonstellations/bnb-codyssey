# Root-level safety net. backend/.gitignore and frontend/.gitignore cover their own
# subtrees; this catches anything created at the repo root.

node_modules/
dist/
*.env
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?
